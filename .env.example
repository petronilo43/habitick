# Copy this file to .env.local and fill in the two values.
# Both are in the Supabase dashboard, in the project's API settings.
# Use the publishable key. The secret key never goes in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Shows the pay buttons. Set it to true only after Stripe (test mode) and the
# payments function are set up: see "Payments" in the README.
VITE_PAYMENTS_ENABLED=false
